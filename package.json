{
  "name": "valhalla",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build:app": "NODE_ENV=production webpack --mode=production",
    "build:sw": "cd firebase-messaging-sw && NODE_ENV=production webpack --mode=production --config webpack.config.js",
    "build": "concurrently \"npm run build:app\" \"npm run build:sw\"",
    "build:app-testnet": "NODE_ENV=testnet webpack --mode=production",
    "build:sw-testnet": "cd firebase-messaging-sw && NODE_ENV=testnet webpack --mode=production --config webpack.config.js",
    "build-testnet": "concurrently \"npm run build:app-testnet\" \"npm run build:sw-testnet\"",
    "dev": "concurrently -k \"webpack --watch --mode=development\" \"cd firebase-messaging-sw && webpack --watch --mode=development\" \"wrangler dev -c wrangler.dev.jsonc --port=8081\"",
    "start": "concurrently -k \"webpack --watch --mode=development\" \"cd firebase-messaging-sw && webpack --watch --mode=development\" \"wrangler dev -c wrangler.dev.jsonc --port=8081\"",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.1",
    "@gaiaprotocol/chat-client": "^0.0.7",
    "@gaiaprotocol/client-common": "^0.0.15",
    "@gaiaprotocol/god-mode-client": "^0.0.5",
    "@gaiaprotocol/god-mode-shared": "^0.0.4",
    "@gaiaprotocol/nft-attribute-editor": "^0.0.2",
    "@ionic/core": "^8.7.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.90.11",
    "@webtaku/el": "^0.1.1",
    "firebase": "^12.6.0",
    "kiwiengine": "^0.5.14",
    "marked": "^17.0.1",
    "navigo": "^8.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.40.3",
    "wagmi": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@gaiaprotocol/chat-worker": "^0.0.4",
    "@gaiaprotocol/god-mode-worker": "^0.0.11",
		"@gaiaprotocol/worker-common": "^0.1.22",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
