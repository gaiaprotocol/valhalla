{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "valhalla",
	"main": "worker/index.ts",
	"compatibility_date": "2025-07-15",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"GAIA_API_URL": "api.gaia.cc"
	}
}